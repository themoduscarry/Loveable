# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real values.

# Contact form backend (https://formspree.io)
# 1. Sign up free at formspree.io and create a new form.
# 2. Point it at virtualbridgeconnect@gmail.com (or wherever enquiries
#    should land) and verify that inbox when Formspree emails you.
# 3. Copy the form id from the endpoint it gives you:
#    https://formspree.io/f/XXXXXXXX  ->  VITE_FORMSPREE_ID=XXXXXXXX
# Leave this unset and the contact form falls back to a mailto: link.
VITE_FORMSPREE_ID=
