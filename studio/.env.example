# Copy to .env.local and fill in. Nothing here has a working default —
# each value comes from an account you create. See README.md for the
# full setup walkthrough.

# --- Supabase (supabase.com — free tier is enough to start) ---------------
# Project Settings -> API -> Project URL / anon public key / service_role key.
# The service role key bypasses Row Level Security — never expose it to the
# browser (it's deliberately NOT prefixed NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub OAuth ------------------------------------------------------
# Not an env var here: create an OAuth App at
# github.com/settings/developers, then paste its Client ID/Secret into
# Supabase's dashboard (Authentication -> Providers -> GitHub). Supabase
# handles the OAuth exchange; this app only calls
# supabase.auth.signInWithOAuth({ provider: "github" }).

# --- AI provider (console.anthropic.com) --------------------------------
# Powers both router tiers today (src/lib/aiProvider.ts). Swapping the
# fast tier to DeepSeek/Gemini per the blueprint's cost model is a
# follow-up — add that provider's key here once one is chosen.
ANTHROPIC_API_KEY=
